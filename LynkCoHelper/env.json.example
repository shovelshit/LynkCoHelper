{
  "user": {
    "username": "你的领克账号手机号，仅账号密码登录流程(login_by_password)参考用，该流程仍需极验滑块，daily_tasks不依赖",
    "password": "你的密码(明文)，仅账号密码登录流程参考用，同样需要极验滑块且未完全验证加密算法，不建议依赖",
    "token": "bearerXXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX，静态token兜底(约30分钟有效)，未配置refreshToken时才会用到",
    "refreshToken": "bearerYYYYYYYY-YYYY-YYYY-YYYY-YYYYYYYYYYYY，约30天有效，配合deviceId可自动续期token，推荐方式",
    "deviceId": "登录/续期时使用的设备id，需与获取refreshToken时用的deviceId保持一致",
    "tokenExpireAt": "token过期时间(毫秒时间戳)，由refreshToken续期成功后自动写入，用于本地缓存判断，无需手动填写"
  },
  "secrets": {
    "h5AppKey": "H5签名用的AppKey(X-Ca-Key)，签到/分享必需",
    "h5AppSecret": "H5签名用的AppSecret，用于HMAC计算X-Ca-Signature，签到/分享必需",
    "nativeAppKey": "App原生签名AppKey，refreshToken续期签名兜底方案+分享原生接口用",
    "nativeAppSecret": "App原生签名AppSecret，用于HMAC计算x-ca-signature，同上",
    "nativeAppCode": "refreshToken续期方案一(AppCode静态认证)必需，Authorization: APPCODE ...",
    "loginAppCode": "仅滑块验证码登录流程(手动获取refreshToken时)需要，daily_tasks不依赖",
    "deviceImei": "模拟设备IMEI，分享任务的风控请求头需要",
    "glDevId": "模拟设备gl_dev_id，refreshToken续期签名兜底方案+分享任务设备指纹头用"
  },
  "notify": {
    "barkKey": "Bark推送Key，可选，用于把签到/分享/积分结果推送到iOS的Bark App，不配置则跳过推送"
  }
}
